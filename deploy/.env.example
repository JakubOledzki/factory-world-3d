# Copy to deploy/.env on the server and fill in (deploy/.env is not in git).
# The domain pointing at the server (an A record to its IP); Caddy gets its certificate for it
DOMAIN=gra.example.com
# The database password: letters and digits only (it goes into a connection string), e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# The account with the mod menu (F8: money, items, tools, plots) on this server, or empty for nobody. Register it in the
# game FIRST, then set it here: until it is registered anyone could take that e-mail and get the menu.
MOD_ACCOUNT=
